<Project Sdk="Microsoft.NET.Sdk">
  <!--
    macOS host for EVE-O Preview. Compiles the platform-neutral sources of ../Eve-O-Preview by link,
    replaces the Windows host services with macOS implementations, and packages an .app bundle with
    the Swift native library (../Eve-O-Preview.Mac.Native). See ../docs/ai/macos-port.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RootNamespace>EveOPreview</RootNamespace>
    <AssemblyName>EVE-O Preview</AssemblyName>
    <Version>10.1.0.34</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
    <!-- Upstream sources use System.Drawing.Primitives types and call Windows APIs only behind host adapters. -->
    <NoWarn>$(NoWarn);CA1416;CS0618;CS8632;SYSLIB1054</NoWarn>
    <AppBundleName>EVE-O Preview</AppBundleName>
    <AppBundleIdentifier>io.github.bandstacker.eve-o-preview</AppBundleIdentifier>
    <CodesignIdentity Condition="'$(CodesignIdentity)' == ''">EVE-O Preview Dev</CodesignIdentity>
    <NativeProjectDir>$(MSBuildThisFileDirectory)..\Eve-O-Preview.Mac.Native\</NativeProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <UpstreamWindowsOnly Include="
      ..\Eve-O-Preview\obj\**;
      ..\Eve-O-Preview\bin\**;
      ..\Eve-O-Preview\AboutBox.cs;
      ..\Eve-O-Preview\AboutBox.Designer.cs;
      ..\Eve-O-Preview\Program.cs;
      ..\Eve-O-Preview\ApplicationBase\DesktopValidation.cs;
      ..\Eve-O-Preview\ApplicationBase\WindowsSessionLifetime.cs;
      ..\Eve-O-Preview\Helper\ProcessHelpers.cs;
      ..\Eve-O-Preview\Input\WindowsGlobalPointerInput.cs;
      ..\Eve-O-Preview\Input\WindowsMessageWindow.cs;
      ..\Eve-O-Preview\Services\Implementation\CpuAffinityService.cs;
      ..\Eve-O-Preview\Services\Implementation\CpuPlacementPolicy.cs;
      ..\Eve-O-Preview\Services\Implementation\DebuggerSidecar.cs;
      ..\Eve-O-Preview\Services\Implementation\DwmThumbnail.cs;
      ..\Eve-O-Preview\Services\Implementation\ForegroundWindowObserver.cs;
      ..\Eve-O-Preview\Services\Implementation\HookService.cs;
      ..\Eve-O-Preview\Services\Implementation\ProcessInfo.cs;
      ..\Eve-O-Preview\Services\Implementation\ProcessMonitor.cs;
      ..\Eve-O-Preview\Services\Implementation\WindowManager.cs;
      ..\Eve-O-Preview\Services\Implementation\WindowsHotkeyService.cs;
      ..\Eve-O-Preview\Services\Interop\DwmNativeMethods.cs;
      ..\Eve-O-Preview\Services\Interop\Gdi32NativeMethods.cs;
      ..\Eve-O-Preview\Services\Interop\KernelNativeMethods.cs;
      ..\Eve-O-Preview\Services\Interop\User32NativeMethods.cs;
      ..\Eve-O-Preview\Services\Interop\WindowsCpuSetApi.cs;
      ..\Eve-O-Preview\View\Implementation\WindowsWorkspaceBackend.Applications.cs;
      ..\Eve-O-Preview\View\Implementation\WindowsWorkspacePreviewCapture.cs;
      ..\Eve-O-Preview\View\Implementation\WindowsWorkspacePreviewRenderer.cs;
      ..\Eve-O-Preview\View\Implementation\WorkspaceWindow.cs;
      ..\Eve-O-Preview\View\Rendering\CompatibilityOverlayRenderer.cs;
      ..\Eve-O-Preview\View\Rendering\NativeCompositionInterop.cs;
      ..\Eve-O-Preview\View\Rendering\NativeCompositionOverlayRenderer.cs;
      ..\Eve-O-Preview\View\Rendering\OverlaySceneRasterizer.cs;
      ..\Eve-O-Preview\View\Rendering\WindowsPreviewWindowAdapter.cs" />
    <Compile Include="..\Eve-O-Preview\**\*.cs" Exclude="@(UpstreamWindowsOnly)" Link="Upstream\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Eve-O-Preview\Resources\LogCatalog.json" LogicalName="EveOPreview.Resources.LogCatalog.json" Link="Upstream\Resources\LogCatalog.json" />
    <EmbeddedResource Include="..\Eve-O-Preview\icon.ico" LogicalName="EveOPreview.Mac.icon.ico" Link="Upstream\icon.ico" />
    <Content Include="..\Eve-O-Preview\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Eve-O-Preview.Mac.Tests" />
    <ProjectReference Include="..\Eve-O-Preview.Preview\Eve-O-Preview.Preview.csproj" />
    <ProjectReference Include="..\Eve-O-Preview.UI\Eve-O-Preview.UI.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Autofac" Version="9.1.0" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="MediatR.Extensions.Autofac.DependencyInjection" Version="14.0.0" />
    <!-- Upstream configuration types use System.Drawing enums/structs; GDI+ is never called on macOS. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Swift native library: built with SwiftPM and copied next to the managed assemblies. -->
  <Target Name="BuildNativeLibrary" BeforeTargets="Build" Condition="'$(SkipNativeBuild)' != 'true'">
    <Exec Command="swift build -c release --package-path &quot;$(NativeProjectDir)&quot;" />
    <ItemGroup>
      <NativeLibrary Include="$(NativeProjectDir).build\release\libEveOMacNative.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeLibrary)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- dotnet publish -c Release produces bin/<config>/EVE-O Preview.app, signed with the local identity. -->
  <Target Name="CreateAppBundle" AfterTargets="Publish">
    <PropertyGroup>
      <AppBundleDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\$(AppBundleName).app\</AppBundleDir>
      <InfoPlistText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Bundle\Info.plist').Replace('@VERSION@', '$(Version)').Replace('@IDENTIFIER@', '$(AppBundleIdentifier)'))</InfoPlistText>
    </PropertyGroup>
    <RemoveDir Directories="$(AppBundleDir)" />
    <ItemGroup>
      <PublishedFiles Include="$(PublishDir)**\*" />
      <NativeLibrary Include="$(NativeProjectDir).build\release\libEveOMacNative.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedFiles)" DestinationFiles="@(PublishedFiles->'$(AppBundleDir)Contents\MacOS\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(NativeLibrary)" DestinationFolder="$(AppBundleDir)Contents\MacOS" />
    <Copy SourceFiles="Bundle\AppIcon.icns" DestinationFolder="$(AppBundleDir)Contents\Resources" Condition="Exists('Bundle\AppIcon.icns')" />
    <WriteLinesToFile File="$(AppBundleDir)Contents\Info.plist" Lines="$(InfoPlistText)" Overwrite="true" />
    <Exec Command="codesign --force --deep --timestamp=none --sign &quot;$(CodesignIdentity)&quot; &quot;$(AppBundleDir)&quot;" />
    <Message Importance="high" Text="App bundle: $(AppBundleDir)" />
  </Target>
</Project>
